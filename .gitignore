# --- MAXFIY: repoga hech qachon tushmasin ---
# Haqiqiy mijoz buyurtmalari, sex fotolari va eski v9 arxivi shu yerda turadi.
# Repo OCHIQ, shuning uchun bu papka git uchun umuman mavjud emas.
# Repo yopilsa ham qoida o'zgarmaydi: mijoz ma'lumoti hamkorlarga ham tegishli emas.
# Ichidagilar mahalliy ish uchun kerak, repoda esa ularning sun'iy nusxasi bor.
_maxfiy/

# --- MIJOZ BUYURTMALARI: repoga hech qachon tushmasin ---
# Bu papkada haqiqiy mijoz buyurtmalari turadi —
# ism-familiya, o'lchamlar, mahsulot tarkibi. Ular FAQAT mahalliy sinov uchun.
# Repoda ularning o'rniga sun'iy namuna fayllar qoladi (namuna\*.project).
namuna/Project/
namuna/image.png

# --- KORPUS NATIJALARI: repoga hech qachon tushmasin ---
# corpus.ps1 har fayl uchun bitta qator yozadi va qator KALITI - fayl yo'li,
# ya'ni MIJOZ PAPKASINING NOMI. Ichida raqamlar bo'lsa ham, birinchi ustunning
# o'zi 205 ta mijoz ismini oshkor qiladi.
# Vositaning o'zi (corpus.ps1) repoda qoladi - u xavfsiz.
tests/corpus-*.csv

# --- test qoldiqlari ---
# smoke.ps1 sahifani nishon yoniga vaqtincha yozadi (-Keep bilan qoladi)
_smoke-run.html
# shot.ps1 chiqargan skrinshotlar — kerak bo'lsa qayta yasaladi (.\tests\shot.ps1)
tests/shot-*.png
# chop etish ko'rinishini tekshirish uchun yasalgan fayllar
tests/prev-*.png
tests/out-*.pdf

# --- OS va muharrir ---
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/

# VS Code: sozlamalar (font, mavzu, qator oxirlari) GLOBAL — har loyihada bir xil.
# Repoda faqat shu loyihaga xos ikkita fayl qoladi:
#   extensions.json — reponi ochgan odamga kengaytma tavsiyasi
#   tasks.json      — build.ps1 va testlarni ishga tushiruvchi vazifalar
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json

# --- vaqtinchalik ---
*.tmp
*.log
